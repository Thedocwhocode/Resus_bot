# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_WEBHOOK_SECRET=seu_webhook_secret_aleatorio
# "webhook" em prod, "polling" em dev
TELEGRAM_MODE=polling
# Usado para registrar o webhook (necessário em modo webhook)
TELEGRAM_WEBHOOK_URL=https://seudominio.com/telegram/webhook

# ── LLM (Groq — Llama 3.3 70B) ───────────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── DeepSeek (Pipeline 2 — síntese pedagógica) ────────────────────────────────
DEEPSEEK_API_KEY=sk-...

# ── RAG / Pipeline de Estudo ──────────────────────────────────────────────────
# Diretório com os PDFs do corpus médico (ex: Rosen's, Tintinalli, diretrizes)
RAG_CORPUS_DIR=/data/corpus
# Diretório para persistir os embeddings ChromaDB
RAG_PERSIST_DIR=/data/rag

# ── OrioSearch self-hosted ────────────────────────────────────────────────────
ORIO_BASE_URL=http://oriosearch:8080

# ── APIs gratuitas (requerem email) ──────────────────────────────────────────
OPENALEX_EMAIL=seu@email.com
UNPAYWALL_EMAIL=seu@email.com

# ── Database ──────────────────────────────────────────────────────────────────
SQLITE_PATH=/data/resusbot.db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
# TTL do cache de respostas em segundos (7 dias padrão)
CACHE_TTL_SECONDS=604800

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_USER=admin
# Hash bcrypt da senha (gere com: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('senha'))")
DASHBOARD_PASSWORD_HASH=$2b$12$HASH_AQUI
DASHBOARD_DOMAIN=https://seudominio.com

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Requisições por minuto por IP no webhook
RATE_LIMIT_PER_IP=60
# Mensagens por minuto por telegram_id
RATE_LIMIT_PER_USER=20

# ── Billing / Mercado Pago ────────────────────────────────────────────────────
# Em sandbox use TEST-...; em produção use APP_USR-...
MP_ACCESS_TOKEN=TEST-...
MP_WEBHOOK_SECRET=segredo_aleatorio_para_validar_webhook
MP_NOTIFICATION_URL=https://seudominio.com/payments/webhook/mercadopago
MP_RETURN_URL=https://t.me/SeuBotUsername
FREE_MONTHLY_CREDITS=10
CREDIT_VALIDITY_DAYS=60

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
